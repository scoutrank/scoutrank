# Copy this file to .env in this same folder (artifacts/scoutrank/.env)
# and fill in your own Supabase project's values.
#
# Find these in your Supabase dashboard:
# Project Settings -> Data API / API Keys
#   VITE_SUPABASE_URL      -> "Project URL"      (e.g. https://xyzcompany.supabase.co)
#   VITE_SUPABASE_ANON_KEY -> "anon" / "public" key

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Scout Bot (AI chat) uses Groq. Get a free key at https://console.groq.com/keys
# NOTE: calls go straight from the browser to Groq, so this key is visible to
# anyone who inspects the site's network requests once deployed publicly.
VITE_GROQ_API_KEY=
